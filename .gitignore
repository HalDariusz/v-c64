# Build artifacts (regenerated by `make`/`make run`)
/build/
/kvm_host

# sidplayer tool build artifacts (cc65/da65) - regenerated, and
# sidplayer.dbg contains an absolute path from the local machine (asminc/c64.inc)
tools/sidplayer/32768
tools/sidplayer/sidplayer.bin
tools/sidplayer/sidplayer.o
tools/sidplayer/sidplayer.dbg
tools/sidplayer/sidplayer.lst
tools/sidplayer/sidplayer.lbl
tools/sidplayer/sidplayer.dis.s

# Private, copyrighted material (real ROM dumps, disk images, and rips of
# commercial game music) - NEVER publish. See roms/README.md - `make`
# creates its own zero-filled placeholders if these files are missing,
# so the repo builds and runs right away without them.
/priv/

# ROMs supplied by the user themselves (see roms/README.md) - not part of
# the repository, regardless of where they happen to sit.
roms/*.bin
roms/*.zip
roms/*backup*

# Generated demo cartridge (playable via tools/demo/build_demo.py)
roms/sprite_sid_demo.bin

# Disk/tape images and SID rips - working/user data, not source
disk/*.d64
disk/*.d64.backup
disk/*.t64
disk/*.prg
disk/*.sid

# Editor/OS cruft
*.swp
*~
.DS_Store

# Python bytecode cache (tools/demo/asm.py imported by build_demo.py)
__pycache__/
*.pyc
